<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ContosoBank</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="min-h-screen flex flex-col bg-gray-50 text-gray-900">
    <header class="bg-white border-b shadow-sm">
        <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16">
            <a class="text-xl font-bold text-blue-900" asp-area="" asp-page="/Index">ContosoBank</a>
            <button id="mobile-menu-btn" type="button" class="sm:hidden inline-flex items-center justify-center p-2 rounded-md text-gray-500 hover:text-gray-700 hover:bg-gray-100" aria-label="Toggle navigation">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
            </button>
            <ul id="nav-links" class="hidden sm:flex gap-6">
                <li><a class="text-gray-700 hover:text-blue-700 font-medium" asp-area="" asp-page="/Index">Home</a></li>
                <li><a class="text-gray-700 hover:text-blue-700 font-medium" asp-area="" asp-page="/Privacy">Privacy</a></li>
            </ul>
        </nav>
        <ul id="mobile-menu" class="hidden sm:hidden px-4 pb-3 space-y-1">
            <li><a class="block text-gray-700 hover:text-blue-700 font-medium py-2" asp-area="" asp-page="/Index">Home</a></li>
            <li><a class="block text-gray-700 hover:text-blue-700 font-medium py-2" asp-area="" asp-page="/Privacy">Privacy</a></li>
        </ul>
    </header>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex-1 w-full">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-t bg-white text-gray-500 text-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
            &copy; 2026 - ContosoBank - <a class="text-blue-700 hover:underline" asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
